MONGO_URI=mongodb://localhost:27017/ems
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# EMS-SR-001 TLS (see docs/TLS.md). Option 1: Node serves HTTPS itself (TLS 1.2+ only).
# TLS_CERT_FILE=certs/localhost.crt
# TLS_KEY_FILE=certs/localhost.key
# HTTP_REDIRECT_PORT=5080
# Option 2: behind a TLS proxy (Render, Railway, nginx).
# TRUST_PROXY=1
# REQUIRE_HTTPS=true
# Bcrypt cost factor (default 12)
# BCRYPT_ROUNDS=12

# Notifications (EMS-F-006, F-015): optional email provider webhook that accepts POST { to, subject, text }.
# Without it, alerts are in-app only (Alerts page).
# NOTIFY_WEBHOOK_URL=https://your-mail-relay.example/send

# Payments (EMS-F-013..015, docs/PAYMENTS.md). Without these keys the built-in sandbox gateway is used.
# Use Razorpay TEST keys (rzp_test_...) for the demo. Never commit real keys.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Performance (EMS-NF-001, docs/PERFORMANCE.md)
# BCRYPT_THREADS=8          # password-hashing worker threads (default: spare cores, max 8)
# SLOW_REQUEST_MS=1000      # log requests slower than this
